ARGS
<(--gene-list)gene-list>
<(--ranked-genes)ranked-genes>
<!(--gene-sets)gene-sets>
<(--background)background>
<!(--outdir/-o)outdir>
<(--id-column)id-column>
  gene_id
<(--score-column)score-column>
  score
<(--min-size)min-size>
  2
<(--max-size)max-size>
  500
<(--pvalue-cutoff)pvalue-cutoff>
  1
<(--padj-method)padj-method>
  BH
<(--top-n)top-n>
  20
<(--seed)seed>
  1

RUN
<taffish>
set -eu

FLOW_NAME="rnaseq-enrichment-flow"
FLOW_VERSION="0.1.0-r3"

gene_list_arg="::gene-list::"
ranked_genes_arg="::ranked-genes::"
gene_sets_arg="::!(--gene-sets)gene-sets::"
background_arg="::background::"
outdir="::!(--outdir/-o)outdir::"
id_column="::id-column::"
score_column="::score-column::"
min_size="::min-size::"
max_size="::max-size::"
pvalue_cutoff="::pvalue-cutoff::"
padj_method="::padj-method::"
top_n="::top-n::"
seed="::seed::"
force_arg="::(--force)force?::"

export normalized_gene_list normalized_ranked_genes normalized_background local_gene_sets enrich_run_dir
export enrichment_dir plot_script extra_plot_script plot_metadata_file plot_summary_file plot_work_dir
export dotplot_pdf dotplot_png dotplot_original_pdf dotplot_original_png
export ora_barplot_pdf ora_barplot_png gsea_nes_plot_pdf gsea_nes_plot_png
export gsea_enrichment_curves_pdf gsea_enrichment_curves_png
export plot_label_wrap_width plot_classic_wrap_width plot_curve_top_n plot_png_dpi
export min_size max_size pvalue_cutoff padj_method top_n seed

flow_log=""

log() {
    printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$FLOW_NAME" "$*" >&2
    if [ -n "$flow_log" ]; then
        printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$FLOW_NAME" "$*" >> "$flow_log"
    fi
}

fail() {
    log "ERROR: $*"
    exit 1
}

sq() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

json_string() {
    printf '%s' "$1" | awk '
        BEGIN {
            ORS = ""
            bs = sprintf("%c", 92)
            dq = sprintf("%c", 34)
            tabc = sprintf("%c", 9)
            cr = sprintf("%c", 13)
            printf dq
        }
        {
            for (i = 1; i <= length($0); i++) {
                c = substr($0, i, 1)
                if (c == bs) {
                    printf "%s%s", bs, bs
                } else if (c == dq) {
                    printf "%s%s", bs, dq
                } else if (c == tabc) {
                    printf "%st", bs
                } else if (c == cr) {
                    printf "%sr", bs
                } else {
                    printf "%s", c
                }
            }
        }
        END {
            printf dq
        }
    '
}

resolve_path() {
    path_value=$1
    base_dir=$2
    case "$path_value" in
        /*) printf '%s\n' "$path_value" ;;
        *) printf '%s/%s\n' "$base_dir" "$path_value" ;;
    esac
}

is_true() {
    case "$1" in
        T|t|true|TRUE|True|1|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

is_integer() {
    awk -v x="$1" 'BEGIN { exit !(x ~ /^[0-9]+$/) }'
}

is_decimal() {
    awk -v x="$1" 'BEGIN { exit !(x ~ /^[0-9]+([.][0-9]+)?$/) }'
}

normalize_gene_ids() {
    input_file=$1
    output_file=$2
    id_name=$3
    label=$4
    allow_empty=$5
    awk -F '\t' -v OFS='\t' -v out="$output_file" -v id="$id_name" -v label="$label" -v allow_empty="$allow_empty" '
        function trim(x) {
            gsub(/^[ \t\r]+/, "", x)
            gsub(/[ \t\r]+$/, "", x)
            return x
        }
        function die(msg) {
            print "ERROR: " label ": " msg > "/dev/stderr"
            exit 2
        }
        function emit(x) {
            x = trim(x)
            if (x == "") return
            if (seen[x]++) die("duplicate gene ID: " x)
            print x > out
            count++
        }
        BEGIN {
            print "gene_id" > out
        }
        NR == 1 {
            col = 0
            for (i = 1; i <= NF; i++) if ($i == id) col = i
            if (col > 0) {
                has_header = 1
                next
            }
            if (NF == 1) {
                col = 1
            } else {
                die("missing column " id)
            }
        }
        /^[ \t\r]*$/ { next }
        {
            if (col < 1 || col > NF) die("missing gene ID field on line " NR)
            emit($col)
        }
        END {
            if (count == 0 && allow_empty != "yes") die("contains no gene IDs")
            print count + 0
        }
    ' "$input_file"
}

normalize_ranked_genes() {
    input_file=$1
    output_file=$2
    id_name=$3
    score_name=$4
    awk -F '\t' -v OFS='\t' -v out="$output_file" -v id="$id_name" -v score="$score_name" '
        function trim(x) {
            gsub(/^[ \t\r]+/, "", x)
            gsub(/[ \t\r]+$/, "", x)
            return x
        }
        function die(msg) {
            print "ERROR: ranked genes: " msg > "/dev/stderr"
            exit 2
        }
        BEGIN {
            print "gene_id", "score" > out
        }
        NR == 1 {
            id_col = 0
            score_col = 0
            for (i = 1; i <= NF; i++) {
                if ($i == id) id_col = i
                if ($i == score) score_col = i
            }
            if (id_col == 0) die("missing column " id)
            if (score_col == 0) die("missing column " score)
            next
        }
        /^[ \t\r]*$/ { next }
        {
            gene = trim($id_col)
            value = trim($score_col)
            if (gene == "" || value == "") next
            if (value !~ /^[-+]?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$/) {
                die("non-numeric score on line " NR ": " value)
            }
            if (seen[gene]++) die("duplicate gene ID: " gene)
            print gene, value > out
            count++
        }
        END {
            if (count == 0) die("contains no valid gene_id/score rows")
            print count + 0
        }
    ' "$input_file"
}

gmt_stats() {
    input_file=$1
    output_file=$2
    awk -F '\t' -v OFS='\t' -v out="$output_file" '
        function trim(x) {
            gsub(/^[ \t\r]+/, "", x)
            gsub(/[ \t\r]+$/, "", x)
            return x
        }
        function die(msg) {
            print "ERROR: gene sets GMT: " msg > "/dev/stderr"
            exit 2
        }
        BEGIN {
            min_size = -1
        }
        /^[ \t\r]*$/ { next }
        NF < 3 {
            die("line " NR " has fewer than 3 fields")
        }
        {
            set_id = trim($1)
            if (set_id == "") die("empty gene set ID on line " NR)
            if (seen_set[set_id]++) die("duplicate gene set ID: " set_id)
            size = 0
            for (i = 3; i <= NF; i++) {
                gene = trim($i)
                if (gene == "") continue
                key = set_id SUBSEP gene
                if (!(key in seen_pair)) {
                    seen_pair[key] = 1
                    size++
                }
                if (!(gene in seen_gene)) {
                    seen_gene[gene] = 1
                    unique_genes++
                }
            }
            if (size > 0) {
                sets++
                if (min_size < 0 || size < min_size) min_size = size
                if (size > max_size) max_size = size
            }
        }
        END {
            if (sets == 0) die("contains no usable gene sets")
            print "metric", "value" > out
            print "gene_sets", sets > out
            print "unique_genes", unique_genes + 0 > out
            print "min_set_size", min_size > out
            print "max_set_size", max_size + 0 > out
        }
    ' "$input_file"
}

metric_value() {
    metric_file=$1
    metric_name=$2
    awk -F '\t' -v key="$metric_name" '$1 == key { print $2; found = 1; exit } END { if (!found) print 0 }' "$metric_file"
}

record_command() {
    step_name=$1
    cmd=$2
    printf '\n# [%s]\n%s\n' "$step_name" "$cmd" >> "$commands_file"
}

for core_cmd in awk cat chmod cp date grep mkdir rm sed sh sort wc; do
    command -v "$core_cmd" >/dev/null 2>&1 || fail "missing required shell utility: $core_cmd"
done

is_integer "$min_size" || fail "--min-size must be a positive integer"
[ "$min_size" -gt 0 ] || fail "--min-size must be greater than zero"
is_integer "$max_size" || fail "--max-size must be a positive integer"
[ "$max_size" -ge "$min_size" ] || fail "--max-size must be greater than or equal to --min-size"
is_integer "$top_n" || fail "--top-n must be a positive integer"
[ "$top_n" -gt 0 ] || fail "--top-n must be greater than zero"
is_integer "$seed" || fail "--seed must be a non-negative integer"
is_decimal "$pvalue_cutoff" || fail "--pvalue-cutoff must be a number between 0 and 1"
awk -v x="$pvalue_cutoff" 'BEGIN { exit !(x >= 0 && !(x > 1)) }' || fail "--pvalue-cutoff must be between 0 and 1"

case "$padj_method" in
    holm|hochberg|hommel|bonferroni|BH|BY|fdr|none) ;;
    *) fail "--padj-method must be one of: holm, hochberg, hommel, bonferroni, BH, BY, fdr, none" ;;
esac

[ -n "$gene_list_arg" ] || [ -n "$ranked_genes_arg" ] || fail "at least one of --gene-list or --ranked-genes is required"

case "$outdir" in
    ''|'.'|'..'|'/') fail "--outdir must be a dedicated output directory" ;;
esac

cwd=$(pwd)
gene_sets_path=$(resolve_path "$gene_sets_arg" "$cwd")
outdir=$(resolve_path "$outdir" "$cwd")

[ -r "$gene_sets_path" ] || fail "cannot read --gene-sets: $gene_sets_path"

have_gene_list=no
have_ranked_genes=no
have_background=no
if [ -n "$gene_list_arg" ]; then
    gene_list_path=$(resolve_path "$gene_list_arg" "$cwd")
    [ -r "$gene_list_path" ] || fail "cannot read --gene-list: $gene_list_path"
    have_gene_list=yes
else
    gene_list_path=""
fi
if [ -n "$ranked_genes_arg" ]; then
    ranked_genes_path=$(resolve_path "$ranked_genes_arg" "$cwd")
    [ -r "$ranked_genes_path" ] || fail "cannot read --ranked-genes: $ranked_genes_path"
    have_ranked_genes=yes
else
    ranked_genes_path=""
fi
if [ -n "$background_arg" ]; then
    background_path=$(resolve_path "$background_arg" "$cwd")
    [ -r "$background_path" ] || fail "cannot read --background: $background_path"
    have_background=yes
else
    background_path=""
fi

if [ -e "$outdir" ]; then
    if is_true "$force_arg"; then
        [ -d "$outdir" ] || fail "--outdir exists and is not a directory: $outdir"
        rm -rf "$outdir/00_inputs" "$outdir/01_logs" "$outdir/02_intermediate" "$outdir/03_results" "$outdir/04_reports" "$outdir/run.manifest.json"
    else
        fail "--outdir already exists: $outdir (use --force to replace rnaseq-enrichment-flow outputs)"
    fi
fi

inputs_dir="$outdir/00_inputs"
logs_dir="$outdir/01_logs"
logs_steps_dir="$logs_dir/steps"
intermediate_dir="$outdir/02_intermediate"
enrich_run_dir="$intermediate_dir/enrichment-r"
plot_work_dir="$intermediate_dir/plot"
results_dir="$outdir/03_results"
enrichment_dir="$results_dir/enrichment"
reports_dir="$outdir/04_reports"

mkdir -p \
    "$inputs_dir" \
    "$logs_steps_dir" \
    "$enrich_run_dir" \
    "$enrichment_dir" \
    "$reports_dir"

flow_log="$logs_dir/flow.log"
commands_file="$reports_dir/commands.sh"
versions_file="$reports_dir/versions.tsv"
methods_file="$reports_dir/methods.txt"
flow_summary_file="$reports_dir/flow_summary.tsv"
manifest_file="$outdir/run.manifest.json"
normalized_gene_list="$intermediate_dir/gene_list.normalized.tsv"
normalized_ranked_genes="$intermediate_dir/ranked_genes.normalized.tsv"
normalized_background="$intermediate_dir/background.normalized.tsv"
gmt_stats_file="$intermediate_dir/gene_sets.stats.tsv"
local_gene_sets="$inputs_dir/gene_sets.gmt"
plot_script="$plot_work_dir/render_dotplot.R"
plot_metadata_file="$enrichment_dir/dotplot_source.tsv"
plot_summary_file="$enrichment_dir/plot_summary.tsv"
dotplot_pdf="$enrichment_dir/dotplot.pdf"
dotplot_png="$enrichment_dir/dotplot.png"
dotplot_original_pdf="$enrichment_dir/dotplot.original.pdf"
dotplot_original_png="$enrichment_dir/dotplot.original.png"
ora_barplot_pdf="$enrichment_dir/ora_barplot.pdf"
ora_barplot_png="$enrichment_dir/ora_barplot.png"
gsea_nes_plot_pdf="$enrichment_dir/gsea_nes_plot.pdf"
gsea_nes_plot_png="$enrichment_dir/gsea_nes_plot.png"
gsea_enrichment_curves_pdf="$enrichment_dir/gsea_enrichment_curves.pdf"
gsea_enrichment_curves_png="$enrichment_dir/gsea_enrichment_curves.png"
plot_label_wrap_width=48
plot_classic_wrap_width=72
plot_curve_top_n=6
plot_png_dpi=220

started_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
: > "$flow_log"
{
    printf '#!/bin/sh\n'
    printf 'set -eu\n\n'
    printf '# Generated by %s %s at %s\n' "$FLOW_NAME" "$FLOW_VERSION" "$started_at"
    printf '# Re-run from a shell with the same input paths and TAFFISH dependency commands in PATH.\n\n'
} > "$commands_file"
chmod +x "$commands_file"

{
    printf 'tool\tversion\tsource\n'
    printf 'rnaseq-enrichment-flow\t%s\ttaffish flow\n' "$FLOW_VERSION"
    printf 'taf-enrichment-r\t0.1.0-r1\ttaffish dependency\n'
} > "$versions_file"

log "begin $FLOW_NAME $FLOW_VERSION"

cp "$gene_sets_path" "$local_gene_sets"
if [ "$have_gene_list" = yes ]; then
    cp "$gene_list_path" "$inputs_dir/gene_list.tsv"
fi
if [ "$have_ranked_genes" = yes ]; then
    cp "$ranked_genes_path" "$inputs_dir/ranked_genes.tsv"
fi
if [ "$have_background" = yes ]; then
    cp "$background_path" "$inputs_dir/background.tsv"
fi

gene_list_count=0
ranked_gene_count=0
background_count=0
gene_set_count=0
gmt_gene_count=0

log "START 01_validate_inputs"
if {
    printf 'gene_sets\t%s\n' "$gene_sets_path"
    [ "$have_gene_list" = no ] || printf 'gene_list\t%s\n' "$gene_list_path"
    [ "$have_ranked_genes" = no ] || printf 'ranked_genes\t%s\n' "$ranked_genes_path"
    [ "$have_background" = no ] || printf 'background\t%s\n' "$background_path"
    printf 'id_column\t%s\n' "$id_column"
    printf 'score_column\t%s\n' "$score_column"
    printf 'min_size\t%s\n' "$min_size"
    printf 'max_size\t%s\n' "$max_size"

    gmt_stats "$local_gene_sets" "$gmt_stats_file"
    cat "$gmt_stats_file"
    gene_set_count=$(metric_value "$gmt_stats_file" gene_sets)
    gmt_gene_count=$(metric_value "$gmt_stats_file" unique_genes)

    if [ "$have_gene_list" = yes ]; then
        gene_list_count=$(normalize_gene_ids "$inputs_dir/gene_list.tsv" "$normalized_gene_list" "$id_column" "gene list" yes)
    fi
    if [ "$have_ranked_genes" = yes ]; then
        ranked_gene_count=$(normalize_ranked_genes "$inputs_dir/ranked_genes.tsv" "$normalized_ranked_genes" "$id_column" "$score_column")
    fi
    if [ "$have_background" = yes ]; then
        background_count=$(normalize_gene_ids "$inputs_dir/background.tsv" "$normalized_background" "$id_column" "background" no)
    fi

    if [ "$gene_list_count" -eq 0 ] && [ "$ranked_gene_count" -eq 0 ]; then
        printf 'ERROR: --gene-list contains no genes and no usable --ranked-genes was provided\n' >&2
        exit 2
    fi

    if [ "$have_background" = yes ] && [ "$gene_list_count" -gt 0 ]; then
        missing_in_background=$(awk -F '\t' '
            FNR == NR {
                if (FNR > 1) bg[$1] = 1
                next
            }
            FNR > 1 && !($1 in bg) { missing++ }
            END { print missing + 0 }
        ' "$normalized_background" "$normalized_gene_list")
        if [ "$missing_in_background" -gt 0 ]; then
            printf 'ERROR: gene list has %s genes outside --background\n' "$missing_in_background" >&2
            exit 2
        fi
    else
        missing_in_background=0
    fi

    gene_list_gmt_overlap=0
    ranked_gmt_overlap=0
    if [ "$gene_list_count" -gt 0 ]; then
        gene_list_gmt_overlap=$(awk -F '\t' '
            FNR == NR {
                for (i = 3; i <= NF; i++) gmt[$i] = 1
                next
            }
            FNR > 1 && ($1 in gmt) { overlap++ }
            END { print overlap + 0 }
        ' "$local_gene_sets" "$normalized_gene_list")
    fi
    if [ "$ranked_gene_count" -gt 0 ]; then
        ranked_gmt_overlap=$(awk -F '\t' '
            FNR == NR {
                for (i = 3; i <= NF; i++) gmt[$i] = 1
                next
            }
            FNR > 1 && ($1 in gmt) { overlap++ }
            END { print overlap + 0 }
        ' "$local_gene_sets" "$normalized_ranked_genes")
    fi
    if [ "$gene_list_count" -gt 0 ] && [ "$gene_list_gmt_overlap" -eq 0 ]; then
        printf 'ERROR: gene list has no overlap with --gene-sets\n' >&2
        exit 2
    fi
    if [ "$ranked_gene_count" -gt 0 ] && [ "$ranked_gmt_overlap" -eq 0 ]; then
        printf 'ERROR: ranked genes have no overlap with --gene-sets\n' >&2
        exit 2
    fi

    printf 'gene_list_count\t%s\n' "$gene_list_count"
    printf 'ranked_gene_count\t%s\n' "$ranked_gene_count"
    printf 'background_count\t%s\n' "$background_count"
    printf 'gene_list_gmt_overlap\t%s\n' "$gene_list_gmt_overlap"
    printf 'ranked_gmt_overlap\t%s\n' "$ranked_gmt_overlap"
    printf 'gene_list_missing_background\t%s\n' "$missing_in_background"
} > "$logs_steps_dir/01_validate_inputs.log" 2>&1; then
    log "DONE  01_validate_inputs"
else
    log "FAIL  01_validate_inputs; see $logs_steps_dir/01_validate_inputs.log"
    exit 1
fi

enrich_cmd="taf-enrichment-r-v0.1.0-r1"
if [ "$gene_list_count" -gt 0 ]; then
    enrich_cmd="$enrich_cmd --gene-list $(sq "$normalized_gene_list")"
fi
if [ "$ranked_gene_count" -gt 0 ]; then
    enrich_cmd="$enrich_cmd --ranked-genes $(sq "$normalized_ranked_genes")"
fi
enrich_cmd="$enrich_cmd --gene-sets $(sq "$local_gene_sets") --outdir $(sq "$enrich_run_dir") --id-column gene_id --score-column score --min-size $(sq "$min_size") --max-size $(sq "$max_size") --pvalue-cutoff $(sq "$pvalue_cutoff") --padj-method $(sq "$padj_method") --top-n $(sq "$top_n") --seed $(sq "$seed") --overwrite"
if [ "$have_background" = yes ] && [ "$gene_list_count" -gt 0 ]; then
    enrich_cmd="$enrich_cmd --background $(sq "$normalized_background")"
fi

step_name="02_enrichment"
step_log="$logs_steps_dir/${step_name}.log"
record_command "$step_name" "$enrich_cmd"
log "START $step_name"
if {
    printf '# step: %s\n' "$step_name"
    printf '# command: %s\n' "$enrich_cmd"
    if [ "$gene_list_count" -gt 0 ] && [ "$ranked_gene_count" -gt 0 ] && [ "$have_background" = yes ]; then
        [[taf: taf-enrichment-r-v0.1.0-r1 --gene-list '"$normalized_gene_list"' --ranked-genes '"$normalized_ranked_genes"' --gene-sets '"$local_gene_sets"' --outdir '"$enrich_run_dir"' --id-column gene_id --score-column score --min-size '"$min_size"' --max-size '"$max_size"' --pvalue-cutoff '"$pvalue_cutoff"' --padj-method '"$padj_method"' --top-n '"$top_n"' --seed '"$seed"' --overwrite --background '"$normalized_background"' ]] </dev/null
    elif [ "$gene_list_count" -gt 0 ] && [ "$ranked_gene_count" -gt 0 ]; then
        [[taf: taf-enrichment-r-v0.1.0-r1 --gene-list '"$normalized_gene_list"' --ranked-genes '"$normalized_ranked_genes"' --gene-sets '"$local_gene_sets"' --outdir '"$enrich_run_dir"' --id-column gene_id --score-column score --min-size '"$min_size"' --max-size '"$max_size"' --pvalue-cutoff '"$pvalue_cutoff"' --padj-method '"$padj_method"' --top-n '"$top_n"' --seed '"$seed"' --overwrite ]] </dev/null
    elif [ "$gene_list_count" -gt 0 ] && [ "$have_background" = yes ]; then
        [[taf: taf-enrichment-r-v0.1.0-r1 --gene-list '"$normalized_gene_list"' --gene-sets '"$local_gene_sets"' --outdir '"$enrich_run_dir"' --id-column gene_id --score-column score --min-size '"$min_size"' --max-size '"$max_size"' --pvalue-cutoff '"$pvalue_cutoff"' --padj-method '"$padj_method"' --top-n '"$top_n"' --seed '"$seed"' --overwrite --background '"$normalized_background"' ]] </dev/null
    elif [ "$gene_list_count" -gt 0 ]; then
        [[taf: taf-enrichment-r-v0.1.0-r1 --gene-list '"$normalized_gene_list"' --gene-sets '"$local_gene_sets"' --outdir '"$enrich_run_dir"' --id-column gene_id --score-column score --min-size '"$min_size"' --max-size '"$max_size"' --pvalue-cutoff '"$pvalue_cutoff"' --padj-method '"$padj_method"' --top-n '"$top_n"' --seed '"$seed"' --overwrite ]] </dev/null
    else
        [[taf: taf-enrichment-r-v0.1.0-r1 --ranked-genes '"$normalized_ranked_genes"' --gene-sets '"$local_gene_sets"' --outdir '"$enrich_run_dir"' --id-column gene_id --score-column score --min-size '"$min_size"' --max-size '"$max_size"' --pvalue-cutoff '"$pvalue_cutoff"' --padj-method '"$padj_method"' --top-n '"$top_n"' --seed '"$seed"' --overwrite ]] </dev/null
    fi
} > "$step_log" 2>&1; then
    log "DONE  $step_name"
else
    status=$?
    log "FAIL  $step_name; see $step_log"
    exit "$status"
fi

cp "$enrich_run_dir/ora_results.tsv" "$enrichment_dir/ora_results.tsv"
cp "$enrich_run_dir/gsea_results.tsv" "$enrichment_dir/gsea_results.tsv"
cp "$enrich_run_dir/enrichment_summary.tsv" "$enrichment_dir/enrichment_summary.tsv"
cp "$enrich_run_dir/versions.tsv" "$reports_dir/enrichment_versions.tsv"
cp "$enrich_run_dir/run.manifest.json" "$intermediate_dir/enrichment-r.run.manifest.json"

ora_result_count=$(metric_value "$enrichment_dir/enrichment_summary.tsv" ora_result_count)
gsea_result_count=$(metric_value "$enrichment_dir/enrichment_summary.tsv" gsea_result_count)
plot_source=$(metric_value "$enrichment_dir/enrichment_summary.tsv" plot_source)
background_source=$(metric_value "$enrichment_dir/enrichment_summary.tsv" background_source)

mkdir -p "$plot_work_dir"
cat > "$plot_script" <<'RSCRIPT'
suppressPackageStartupMessages({
  library(data.table)
  library(ggplot2)
  library(grid)
})

args <- commandArgs(trailingOnly = TRUE)
if (length(args) != 7L) {
  stop("usage: render_dotplot.R ORA_TSV GSEA_TSV PDF PNG METADATA TOP_N WRAP_WIDTH", call. = FALSE)
}

ora_path <- args[[1L]]
gsea_path <- args[[2L]]
pdf_path <- args[[3L]]
png_path <- args[[4L]]
metadata_path <- args[[5L]]
top_n <- as.integer(args[[6L]])
wrap_width <- as.integer(args[[7L]])
if (is.na(top_n) || top_n < 1L) top_n <- 20L
if (is.na(wrap_width) || wrap_width < 20L) wrap_width <- 48L

read_result <- function(path) {
  if (!file.exists(path) || file.info(path)$size == 0) {
    return(data.table())
  }
  fread(path, sep = "\t", header = TRUE, data.table = TRUE)
}

as_num <- function(x) {
  suppressWarnings(as.numeric(x))
}

wrap_label <- function(x, width) {
  x <- ifelse(is.na(x) | x == "", "", x)
  vapply(x, function(one) {
    lines <- strwrap(one, width = width, simplify = FALSE)[[1L]]
    if (length(lines) == 0L) {
      one
    } else {
      paste(lines, collapse = "\n")
    }
  }, character(1L), USE.NAMES = FALSE)
}

unique_plot_labels <- function(labels, ids) {
  labels <- ifelse(is.na(labels) | labels == "", ids, labels)
  wrapped <- wrap_label(labels, wrap_width)
  if (anyDuplicated(wrapped)) {
    wrapped <- ifelse(is.na(ids) | ids == "", wrapped, paste0(wrapped, "\n", ids))
  }
  make.unique(wrapped, sep = " ")
}

plot_theme <- theme_bw(base_size = 10) +
  theme(
    axis.text.y = element_text(size = 8, lineheight = 0.9),
    axis.title.x = element_text(size = 10),
    plot.title = element_text(size = 11, face = "bold"),
    legend.title = element_text(size = 9),
    legend.text = element_text(size = 8),
    plot.margin = margin(10, 14, 10, 10)
  )

ora <- read_result(ora_path)
gsea <- read_result(gsea_path)
plot_source <- "empty"

if (nrow(ora) > 0L) {
  ora[, pvalue := as_num(pvalue)]
  ora[, p.adjust := as_num(p.adjust)]
  ora[, Count := as_num(Count)]
  ora <- ora[order(p.adjust, pvalue, ID)]
  dt <- copy(ora[seq_len(min(top_n, nrow(ora)))])
  dt[, score := -log10(p.adjust + .Machine$double.xmin)]
  dt[, label := unique_plot_labels(ifelse(is.na(Description) | Description == "", ID, Description), ID)]
  dt[, label := factor(label, levels = rev(label))]
  p <- ggplot(dt, aes(x = score, y = label, size = Count, color = p.adjust)) +
    geom_point(alpha = 0.9) +
    scale_color_viridis_c(option = "C", direction = -1) +
    labs(
      x = "-log10(adjusted p-value)",
      y = NULL,
      size = "Count",
      color = "Adjusted p",
      title = "ORA enrichment"
    ) +
    plot_theme
  plot_source <- "ora"
} else if (nrow(gsea) > 0L) {
  gsea[, pvalue := as_num(pvalue)]
  gsea[, p.adjust := as_num(p.adjust)]
  gsea[, NES := as_num(NES)]
  gsea[, size := as_num(size)]
  gsea[, absNES := abs(NES)]
  gsea <- gsea[order(p.adjust, -absNES, ID)]
  dt <- copy(gsea[seq_len(min(top_n, nrow(gsea)))])
  dt[, label := unique_plot_labels(ifelse(is.na(Description) | Description == "", ID, Description), ID)]
  dt[, label := factor(label, levels = label[order(NES)])]
  p <- ggplot(dt, aes(x = NES, y = label, size = size, color = p.adjust)) +
    geom_point(alpha = 0.9) +
    scale_color_viridis_c(option = "C", direction = -1) +
    labs(
      x = "Normalized enrichment score",
      y = NULL,
      size = "Size",
      color = "Adjusted p",
      title = "GSEA enrichment"
    ) +
    plot_theme
  plot_source <- "gsea"
} else {
  dt <- data.table()
  p <- ggplot() +
    annotate("text", x = 0, y = 0, label = "No enrichment results", size = 5) +
    theme_void(base_size = 11)
}

terms_plotted <- nrow(dt)
plot_width <- 12.5
plot_height <- max(5.5, min(15, 3.0 + 0.48 * max(terms_plotted, 1L)))

ggsave(pdf_path, p, width = plot_width, height = plot_height, units = "in", limitsize = FALSE)
ggsave(png_path, p, width = plot_width, height = plot_height, units = "in", dpi = 200, limitsize = FALSE)

metadata <- data.table(
  metric = c(
    "plot_renderer",
    "plot_source",
    "plot_terms",
    "plot_label_wrap_width",
    "plot_width_inches",
    "plot_height_inches",
    "plot_png_dpi"
  ),
  value = c(
    "rnaseq-enrichment-flow",
    plot_source,
    as.character(terms_plotted),
    as.character(wrap_width),
    as.character(plot_width),
    as.character(plot_height),
    "200"
  )
)
fwrite(metadata, metadata_path, sep = "\t")
RSCRIPT

render_cmd="taf-enrichment-r-v0.1.0-r1 Rscript $(sq "$plot_script") $(sq "$enrichment_dir/ora_results.tsv") $(sq "$enrichment_dir/gsea_results.tsv") $(sq "$enrichment_dir/dotplot.pdf") $(sq "$enrichment_dir/dotplot.png") $(sq "$plot_metadata_file") $(sq "$top_n") $(sq "$plot_label_wrap_width")"
step_name="03_render_dotplot"
step_log="$logs_steps_dir/${step_name}.log"
record_command "$step_name" "$render_cmd"
log "START $step_name"
if {
    printf '# step: %s\n' "$step_name"
    printf '# command: %s\n' "$render_cmd"
    [[taf: taf-enrichment-r-v0.1.0-r1 Rscript '"$plot_script"' '"$enrichment_dir/ora_results.tsv"' '"$enrichment_dir/gsea_results.tsv"' '"$enrichment_dir/dotplot.pdf"' '"$enrichment_dir/dotplot.png"' '"$plot_metadata_file"' '"$top_n"' '"$plot_label_wrap_width"' ]] </dev/null
    test -s "$enrichment_dir/dotplot.pdf" || { printf 'ERROR: missing rendered dotplot.pdf\n' >&2; exit 2; }
    test -s "$enrichment_dir/dotplot.png" || { printf 'ERROR: missing rendered dotplot.png\n' >&2; exit 2; }
    test -s "$plot_metadata_file" || { printf 'ERROR: missing dotplot metadata\n' >&2; exit 2; }
} > "$step_log" 2>&1; then
    log "DONE  $step_name"
else
    status=$?
    log "FAIL  $step_name; see $step_log"
    exit "$status"
fi

extra_plot_script="$plot_work_dir/render_extra_plots.R"
cat > "$extra_plot_script" <<'RSCRIPT'
suppressPackageStartupMessages({
  library(data.table)
  library(ggplot2)
  library(grid)
})

args <- commandArgs(trailingOnly = TRUE)
if (length(args) != 18L) {
  stop("usage: render_extra_plots.R ORA_TSV GSEA_TSV RANKED_TSV GMT CLASSIC_PDF CLASSIC_PNG ORA_BAR_PDF ORA_BAR_PNG GSEA_NES_PDF GSEA_NES_PNG CURVES_PDF CURVES_PNG METADATA SUMMARY TOP_N MAIN_WRAP CLASSIC_WRAP CURVE_TOP_N", call. = FALSE)
}

ora_path <- args[[1L]]
gsea_path <- args[[2L]]
ranked_path <- args[[3L]]
gmt_path <- args[[4L]]
classic_pdf <- args[[5L]]
classic_png <- args[[6L]]
ora_bar_pdf <- args[[7L]]
ora_bar_png <- args[[8L]]
gsea_nes_pdf <- args[[9L]]
gsea_nes_png <- args[[10L]]
gsea_curves_pdf <- args[[11L]]
gsea_curves_png <- args[[12L]]
metadata_path <- args[[13L]]
summary_path <- args[[14L]]
top_n <- as.integer(args[[15L]])
wrap_width <- as.integer(args[[16L]])
classic_wrap_width <- as.integer(args[[17L]])
curve_top_n <- as.integer(args[[18L]])
if (is.na(top_n) || top_n < 1L) top_n <- 20L
if (is.na(wrap_width) || wrap_width < 20L) wrap_width <- 48L
if (is.na(classic_wrap_width) || classic_wrap_width < 30L) classic_wrap_width <- 72L
if (is.na(curve_top_n) || curve_top_n < 1L) curve_top_n <- 6L
png_dpi <- 220L

read_result <- function(path) {
  if (!file.exists(path) || file.info(path)$size == 0) return(data.table())
  fread(path, sep = "\t", header = TRUE, data.table = TRUE)
}

as_num <- function(x) suppressWarnings(as.numeric(x))

ensure_numeric <- function(dt, col, default = NA_real_) {
  if (!(col %in% names(dt))) dt[, (col) := default]
  dt[, (col) := as_num(get(col))]
  invisible(dt)
}

wrap_label <- function(x, width) {
  x <- ifelse(is.na(x) | x == "", "", x)
  vapply(x, function(one) {
    lines <- strwrap(one, width = width, simplify = FALSE)[[1L]]
    if (length(lines) == 0L) one else paste(lines, collapse = "\n")
  }, character(1L), USE.NAMES = FALSE)
}

term_label <- function(dt) {
  labels <- if ("Description" %in% names(dt)) dt[["Description"]] else rep("", nrow(dt))
  ids <- if ("ID" %in% names(dt)) dt[["ID"]] else seq_len(nrow(dt))
  labels <- ifelse(is.na(labels) | labels == "", ids, labels)
  ids <- ifelse(is.na(ids) | ids == "", labels, ids)
  list(labels = labels, ids = ids)
}

unique_plot_labels <- function(labels, ids, width) {
  labels <- ifelse(is.na(labels) | labels == "", ids, labels)
  wrapped <- wrap_label(labels, width)
  if (anyDuplicated(wrapped)) {
    wrapped <- ifelse(is.na(ids) | ids == "", wrapped, paste0(wrapped, "\n", ids))
  }
  make.unique(wrapped, sep = " ")
}

base_theme <- function(base_size = 10) {
  theme_bw(base_size = base_size) +
    theme(
      panel.grid.major.y = element_blank(),
      panel.grid.minor = element_blank(),
      axis.text.y = element_text(size = 8.5, lineheight = 0.92),
      axis.text.x = element_text(size = 8.5),
      axis.title.x = element_text(size = 10),
      axis.title.y = element_text(size = 10),
      plot.title = element_text(size = 12, face = "bold"),
      plot.subtitle = element_text(size = 9.5, color = "#5A5F66"),
      legend.title = element_text(size = 9),
      legend.text = element_text(size = 8),
      legend.key.height = unit(0.35, "in"),
      plot.margin = margin(10, 16, 10, 10)
    )
}

plot_theme <- base_theme(10)

empty_plot <- function(title, message) {
  ggplot() +
    annotate("text", x = 0, y = 0, label = message, size = 4.5, color = "#4A4F55") +
    labs(title = title) +
    theme_void(base_size = 11) +
    theme(
      plot.title = element_text(size = 12, face = "bold", hjust = 0.5),
      plot.margin = margin(16, 16, 16, 16)
    )
}

save_plot <- function(path_pdf, path_png, plot, width, height) {
  ggsave(path_pdf, plot, width = width, height = height, units = "in", limitsize = FALSE)
  ggsave(path_png, plot, width = width, height = height, units = "in", dpi = png_dpi, limitsize = FALSE)
  invisible(NULL)
}

height_for_terms <- function(n, min_height = 5.5, max_height = 16, per_term = 0.48) {
  max(min_height, min(max_height, 3.0 + per_term * max(n, 1L)))
}

prepare_ora <- function(ora) {
  if (nrow(ora) == 0L) return(ora)
  if (!("ID" %in% names(ora))) ora[, ID := as.character(seq_len(.N))]
  if (!("Description" %in% names(ora))) ora[, Description := ID]
  ensure_numeric(ora, "pvalue")
  ensure_numeric(ora, "p.adjust")
  ensure_numeric(ora, "Count", 0)
  ora[is.na(p.adjust), p.adjust := 1]
  ora[is.na(pvalue), pvalue := 1]
  ora[is.na(Count), Count := 0]
  ora[, score := -log10(p.adjust + .Machine$double.xmin)]
  ora[order(p.adjust, pvalue, ID)]
}

prepare_gsea <- function(gsea) {
  if (nrow(gsea) == 0L) return(gsea)
  if (!("ID" %in% names(gsea))) gsea[, ID := as.character(seq_len(.N))]
  if (!("Description" %in% names(gsea))) gsea[, Description := ID]
  ensure_numeric(gsea, "pvalue")
  ensure_numeric(gsea, "p.adjust")
  ensure_numeric(gsea, "NES", 0)
  ensure_numeric(gsea, "size", 0)
  gsea[is.na(p.adjust), p.adjust := 1]
  gsea[is.na(pvalue), pvalue := 1]
  gsea[is.na(NES), NES := 0]
  gsea[is.na(size), size := 0]
  gsea[, absNES := abs(NES)]
  gsea[order(p.adjust, -absNES, ID)]
}

make_dotplot <- function(ora, gsea, n, label_width, title_prefix = "") {
  source <- "empty"
  dt <- data.table()
  if (nrow(ora) > 0L) {
    dt <- copy(ora[seq_len(min(n, nrow(ora)))])
    labels <- term_label(dt)
    dt[, label := unique_plot_labels(labels$labels, labels$ids, label_width)]
    dt[, label := factor(label, levels = rev(label))]
    p <- ggplot(dt, aes(x = score, y = label, size = Count, color = p.adjust)) +
      geom_point(alpha = 0.9) +
      scale_color_viridis_c(option = "C", direction = -1, name = "Adjusted p") +
      scale_size_continuous(range = c(2.3, 8.5)) +
      labs(
        x = "-log10(adjusted p-value)",
        y = NULL,
        size = "Count",
        title = paste0(title_prefix, "ORA enrichment")
      ) +
      plot_theme
    source <- "ora"
  } else if (nrow(gsea) > 0L) {
    dt <- copy(gsea[seq_len(min(n, nrow(gsea)))])
    labels <- term_label(dt)
    dt[, label := unique_plot_labels(labels$labels, labels$ids, label_width)]
    dt[, label := factor(label, levels = label[order(NES)])]
    p <- ggplot(dt, aes(x = NES, y = label, size = size, color = p.adjust)) +
      geom_vline(xintercept = 0, linewidth = 0.35, color = "#9AA1AA") +
      geom_point(alpha = 0.9) +
      scale_color_viridis_c(option = "C", direction = -1, name = "Adjusted p") +
      scale_size_continuous(range = c(2.3, 8.5)) +
      labs(
        x = "Normalized enrichment score",
        y = NULL,
        size = "Size",
        title = paste0(title_prefix, "GSEA enrichment")
      ) +
      plot_theme
    source <- "gsea"
  } else {
    p <- empty_plot(paste0(title_prefix, "Enrichment dotplot"), "No enrichment results")
  }
  list(plot = p, data = dt, source = source)
}

make_ora_barplot <- function(ora, n) {
  if (nrow(ora) == 0L) {
    return(list(plot = empty_plot("ORA top terms", "No ORA results"), terms = 0L))
  }
  dt <- copy(ora[seq_len(min(n, nrow(ora)))])
  labels <- term_label(dt)
  dt[, label := unique_plot_labels(labels$labels, labels$ids, wrap_width)]
  dt[, label := factor(label, levels = rev(label))]
  p <- ggplot(dt, aes(x = score, y = label, fill = p.adjust)) +
    geom_col(width = 0.74, color = "white", linewidth = 0.25) +
    scale_fill_viridis_c(option = "C", direction = -1, name = "Adjusted p") +
    labs(
      x = "-log10(adjusted p-value)",
      y = NULL,
      title = "ORA top terms",
      subtitle = "Over-representation analysis ranked by adjusted p-value"
    ) +
    plot_theme
  list(plot = p, terms = nrow(dt))
}

make_gsea_nes_plot <- function(gsea, n) {
  if (nrow(gsea) == 0L) {
    return(list(plot = empty_plot("GSEA normalized enrichment scores", "No GSEA results"), terms = 0L))
  }
  dt <- copy(gsea[seq_len(min(n, nrow(gsea)))])
  labels <- term_label(dt)
  dt[, label := unique_plot_labels(labels$labels, labels$ids, wrap_width)]
  dt[, label := factor(label, levels = label[order(NES)])]
  p <- ggplot(dt, aes(x = NES, y = label, fill = NES)) +
    geom_vline(xintercept = 0, linewidth = 0.35, color = "#9AA1AA") +
    geom_col(width = 0.72, color = "white", linewidth = 0.25) +
    scale_fill_gradient2(low = "#3B82F6", mid = "#F7F7F7", high = "#D14D72", midpoint = 0, name = "NES") +
    labs(
      x = "Normalized enrichment score",
      y = NULL,
      title = "GSEA normalized enrichment scores",
      subtitle = "Positive NES indicates enrichment near the top of the ranked gene list"
    ) +
    plot_theme
  list(plot = p, terms = nrow(dt))
}

read_ranked <- function(path) {
  if (!file.exists(path) || file.info(path)$size == 0) return(data.table())
  dt <- fread(path, sep = "\t", header = TRUE, data.table = TRUE)
  if (!all(c("gene_id", "score") %in% names(dt))) return(data.table())
  dt[, gene_id := as.character(gene_id)]
  dt[, score := as_num(score)]
  dt <- dt[!is.na(gene_id) & gene_id != "" & !is.na(score)]
  dt[order(-score, gene_id)]
}

read_gmt_sets <- function(path) {
  if (!file.exists(path) || file.info(path)$size == 0) return(list())
  lines <- readLines(path, warn = FALSE)
  sets <- list()
  for (line in lines) {
    if (!nzchar(line)) next
    fields <- strsplit(line, "\t", fixed = TRUE)[[1L]]
    if (length(fields) < 3L) next
    set_id <- fields[[1L]]
    genes <- unique(fields[-c(1L, 2L)])
    genes <- genes[nzchar(genes)]
    sets[[set_id]] <- genes
  }
  sets
}

running_score <- function(ranked, genes, set_id, description, nes, padj) {
  if (nrow(ranked) == 0L || length(genes) == 0L) return(data.table())
  hit <- ranked$gene_id %in% genes
  hits <- sum(hit)
  misses <- sum(!hit)
  if (hits == 0L || misses == 0L) return(data.table())
  weights <- abs(ranked$score)
  hit_weight <- sum(weights[hit])
  if (!is.finite(hit_weight) || hit_weight == 0) {
    increment <- ifelse(hit, 1 / hits, -1 / misses)
  } else {
    increment <- ifelse(hit, weights / hit_weight, -1 / misses)
  }
  data.table(
    ID = set_id,
    Description = description,
    NES = nes,
    p.adjust = padj,
    rank = seq_len(nrow(ranked)),
    running_score = cumsum(increment)
  )
}

make_gsea_curves <- function(gsea, ranked_path, gmt_path, n) {
  if (nrow(gsea) == 0L) {
    return(list(plot = empty_plot("GSEA running enrichment scores", "No GSEA results"), terms = 0L))
  }
  ranked <- read_ranked(ranked_path)
  sets <- read_gmt_sets(gmt_path)
  if (nrow(ranked) == 0L || length(sets) == 0L) {
    return(list(plot = empty_plot("GSEA running enrichment scores", "Ranked genes or GMT sets are unavailable"), terms = 0L))
  }
  top <- copy(gsea[seq_len(min(n, nrow(gsea)))])
  curves <- rbindlist(lapply(seq_len(nrow(top)), function(i) {
    set_id <- top$ID[[i]]
    if (!(set_id %in% names(sets))) return(data.table())
    running_score(ranked, sets[[set_id]], set_id, top$Description[[i]], top$NES[[i]], top$p.adjust[[i]])
  }), fill = TRUE)
  if (nrow(curves) == 0L) {
    return(list(plot = empty_plot("GSEA running enrichment scores", "Top GSEA terms have no ranked-gene overlap"), terms = 0L))
  }
  label_map <- data.table(ID = unique(curves$ID))
  label_source <- top[match(label_map$ID, ID)]
  label_map[, label := unique_plot_labels(label_source$Description, label_source$ID, 46)]
  curves <- merge(curves, label_map, by = "ID", all.x = TRUE, sort = FALSE)
  curves[, label := factor(label, levels = unique(label))]
  p <- ggplot(curves, aes(x = rank, y = running_score, color = NES, group = ID)) +
    geom_hline(yintercept = 0, linewidth = 0.25, color = "#9AA1AA") +
    geom_line(linewidth = 0.65) +
    scale_color_gradient2(low = "#3B82F6", mid = "#6B7280", high = "#D14D72", midpoint = 0, name = "NES") +
    facet_wrap(~label, scales = "free_y", ncol = 2) +
    labs(
      x = "Rank in preranked gene list",
      y = "Running enrichment score",
      title = "GSEA running enrichment scores",
      subtitle = "Top terms by adjusted p-value"
    ) +
    base_theme(9.5) +
    theme(
      strip.text = element_text(size = 7.5, lineheight = 0.9),
      panel.grid.major.y = element_line(color = "#E7E9ED", linewidth = 0.25),
      legend.position = "right"
    )
  list(plot = p, terms = length(unique(curves$ID)))
}

ora <- prepare_ora(read_result(ora_path))
gsea <- prepare_gsea(read_result(gsea_path))
classic_dot <- make_dotplot(ora, gsea, top_n, classic_wrap_width, title_prefix = "Classic ")
ora_bar <- make_ora_barplot(ora, top_n)
gsea_nes <- make_gsea_nes_plot(gsea, top_n)
gsea_curves <- make_gsea_curves(gsea, ranked_path, gmt_path, curve_top_n)

classic_terms <- nrow(classic_dot$data)
classic_width <- 16.0
classic_height <- height_for_terms(classic_terms, min_height = 6.0, max_height = 17, per_term = 0.50)
bar_width <- 12.5
bar_height <- height_for_terms(ora_bar$terms)
nes_width <- 12.5
nes_height <- height_for_terms(gsea_nes$terms)
curves_width <- 12.5
curves_height <- max(6.2, min(12, 4.1 + 1.1 * ceiling(max(gsea_curves$terms, 1L) / 2)))

save_plot(classic_pdf, classic_png, classic_dot$plot, classic_width, classic_height)
save_plot(ora_bar_pdf, ora_bar_png, ora_bar$plot, bar_width, bar_height)
save_plot(gsea_nes_pdf, gsea_nes_png, gsea_nes$plot, nes_width, nes_height)
save_plot(gsea_curves_pdf, gsea_curves_png, gsea_curves$plot, curves_width, curves_height)

extra_metadata <- data.table(
  metric = c(
    "plot_family_version",
    "classic_plot_source",
    "classic_plot_terms",
    "classic_label_wrap_width",
    "classic_width_inches",
    "classic_height_inches",
    "ora_barplot_terms",
    "gsea_nes_terms",
    "gsea_curve_terms",
    "gsea_curve_top_n",
    "extra_plot_png_dpi"
  ),
  value = c(
    "0.1.0-r3",
    classic_dot$source,
    as.character(classic_terms),
    as.character(classic_wrap_width),
    as.character(classic_width),
    as.character(classic_height),
    as.character(ora_bar$terms),
    as.character(gsea_nes$terms),
    as.character(gsea_curves$terms),
    as.character(curve_top_n),
    as.character(png_dpi)
  )
)
fwrite(extra_metadata, metadata_path, sep = "\t", append = TRUE, col.names = FALSE)

main_terms <- NA_integer_
if (file.exists(metadata_path) && file.info(metadata_path)$size > 0) {
  metadata_now <- fread(metadata_path, sep = "\t", header = TRUE, data.table = TRUE)
  main_terms_value <- metadata_now[metric == "plot_terms", value][1L]
  main_terms <- suppressWarnings(as.integer(main_terms_value))
}

plot_summary <- data.table(
  plot = c("dotplot", "dotplot.original", "ora_barplot", "gsea_nes_plot", "gsea_enrichment_curves"),
  source = c("flow-readable", classic_dot$source, "ora", "gsea", "gsea"),
  terms = c(main_terms, classic_terms, ora_bar$terms, gsea_nes$terms, gsea_curves$terms),
  pdf = c(file.path(dirname(classic_pdf), "dotplot.pdf"), classic_pdf, ora_bar_pdf, gsea_nes_pdf, gsea_curves_pdf),
  png = c(file.path(dirname(classic_png), "dotplot.png"), classic_png, ora_bar_png, gsea_nes_png, gsea_curves_png),
  note = c(
    "Primary readable dotplot with wrapped labels",
    "Optimized classic/original-style dotplot with wider labels",
    "ORA top terms as adjusted-p-value bars",
    "GSEA normalized enrichment score bars",
    "Running enrichment score curves for top GSEA terms"
  )
)
fwrite(plot_summary, summary_path, sep = "\t")
RSCRIPT

extra_render_cmd="taf-enrichment-r-v0.1.0-r1 Rscript $(sq "$extra_plot_script") $(sq "$enrichment_dir/ora_results.tsv") $(sq "$enrichment_dir/gsea_results.tsv") $(sq "$normalized_ranked_genes") $(sq "$local_gene_sets") $(sq "$dotplot_original_pdf") $(sq "$dotplot_original_png") $(sq "$ora_barplot_pdf") $(sq "$ora_barplot_png") $(sq "$gsea_nes_plot_pdf") $(sq "$gsea_nes_plot_png") $(sq "$gsea_enrichment_curves_pdf") $(sq "$gsea_enrichment_curves_png") $(sq "$plot_metadata_file") $(sq "$plot_summary_file") $(sq "$top_n") $(sq "$plot_label_wrap_width") $(sq "$plot_classic_wrap_width") $(sq "$plot_curve_top_n")"
step_name="04_render_extra_plots"
step_log="$logs_steps_dir/${step_name}.log"
record_command "$step_name" "$extra_render_cmd"
log "START $step_name"
if {
    printf '# step: %s\n' "$step_name"
    printf '# command: %s\n' "$extra_render_cmd"
    [[taf: taf-enrichment-r-v0.1.0-r1 Rscript '"$extra_plot_script"' '"$enrichment_dir/ora_results.tsv"' '"$enrichment_dir/gsea_results.tsv"' '"$normalized_ranked_genes"' '"$local_gene_sets"' '"$dotplot_original_pdf"' '"$dotplot_original_png"' '"$ora_barplot_pdf"' '"$ora_barplot_png"' '"$gsea_nes_plot_pdf"' '"$gsea_nes_plot_png"' '"$gsea_enrichment_curves_pdf"' '"$gsea_enrichment_curves_png"' '"$plot_metadata_file"' '"$plot_summary_file"' '"$top_n"' '"$plot_label_wrap_width"' '"$plot_classic_wrap_width"' '"$plot_curve_top_n"' ]] </dev/null
    test -s "$dotplot_original_pdf" || { printf 'ERROR: missing rendered dotplot.original.pdf\n' >&2; exit 2; }
    test -s "$dotplot_original_png" || { printf 'ERROR: missing rendered dotplot.original.png\n' >&2; exit 2; }
    test -s "$ora_barplot_pdf" || { printf 'ERROR: missing rendered ora_barplot.pdf\n' >&2; exit 2; }
    test -s "$ora_barplot_png" || { printf 'ERROR: missing rendered ora_barplot.png\n' >&2; exit 2; }
    test -s "$gsea_nes_plot_pdf" || { printf 'ERROR: missing rendered gsea_nes_plot.pdf\n' >&2; exit 2; }
    test -s "$gsea_nes_plot_png" || { printf 'ERROR: missing rendered gsea_nes_plot.png\n' >&2; exit 2; }
    test -s "$gsea_enrichment_curves_pdf" || { printf 'ERROR: missing rendered gsea_enrichment_curves.pdf\n' >&2; exit 2; }
    test -s "$gsea_enrichment_curves_png" || { printf 'ERROR: missing rendered gsea_enrichment_curves.png\n' >&2; exit 2; }
    test -s "$plot_summary_file" || { printf 'ERROR: missing plot summary\n' >&2; exit 2; }
} > "$step_log" 2>&1; then
    log "DONE  $step_name"
else
    status=$?
    log "FAIL  $step_name; see $step_log"
    exit "$status"
fi

rendered_plot_source=$(metric_value "$plot_metadata_file" plot_source)
plot_terms=$(metric_value "$plot_metadata_file" plot_terms)
plot_width_inches=$(metric_value "$plot_metadata_file" plot_width_inches)
plot_height_inches=$(metric_value "$plot_metadata_file" plot_height_inches)
classic_plot_terms=$(metric_value "$plot_metadata_file" classic_plot_terms)
ora_barplot_terms=$(metric_value "$plot_metadata_file" ora_barplot_terms)
gsea_nes_terms=$(metric_value "$plot_metadata_file" gsea_nes_terms)
gsea_curve_terms=$(metric_value "$plot_metadata_file" gsea_curve_terms)

{
    printf 'metric\tvalue\n'
    printf 'flow\t%s\n' "$FLOW_NAME"
    printf 'version\t%s\n' "$FLOW_VERSION"
    printf 'gene_sets\t%s\n' "$gene_set_count"
    printf 'gmt_unique_genes\t%s\n' "$gmt_gene_count"
    printf 'gene_list_genes\t%s\n' "$gene_list_count"
    printf 'ranked_genes\t%s\n' "$ranked_gene_count"
    printf 'background_genes\t%s\n' "$background_count"
    printf 'gene_list_gmt_overlap\t%s\n' "$gene_list_gmt_overlap"
    printf 'ranked_gmt_overlap\t%s\n' "$ranked_gmt_overlap"
    printf 'ora_result_count\t%s\n' "$ora_result_count"
    printf 'gsea_result_count\t%s\n' "$gsea_result_count"
    printf 'plot_source\t%s\n' "$plot_source"
    printf 'rendered_plot_source\t%s\n' "$rendered_plot_source"
    printf 'plot_terms\t%s\n' "$plot_terms"
    printf 'plot_label_wrap_width\t%s\n' "$plot_label_wrap_width"
    printf 'plot_width_inches\t%s\n' "$plot_width_inches"
    printf 'plot_height_inches\t%s\n' "$plot_height_inches"
    printf 'classic_plot_terms\t%s\n' "$classic_plot_terms"
    printf 'classic_label_wrap_width\t%s\n' "$plot_classic_wrap_width"
    printf 'ora_barplot_terms\t%s\n' "$ora_barplot_terms"
    printf 'gsea_nes_terms\t%s\n' "$gsea_nes_terms"
    printf 'gsea_curve_terms\t%s\n' "$gsea_curve_terms"
    printf 'gsea_curve_top_n\t%s\n' "$plot_curve_top_n"
    printf 'background_source\t%s\n' "$background_source"
    printf 'min_size\t%s\n' "$min_size"
    printf 'max_size\t%s\n' "$max_size"
    printf 'pvalue_cutoff\t%s\n' "$pvalue_cutoff"
    printf 'padj_method\t%s\n' "$padj_method"
} > "$flow_summary_file"

{
    printf 'rnaseq-enrichment-flow %s ran offline GMT-based enrichment analysis. ' "$FLOW_VERSION"
    if [ "$gene_list_count" -gt 0 ]; then
        printf 'ORA used %s query genes' "$gene_list_count"
        if [ "$have_background" = yes ]; then
            printf ' against an explicit background of %s genes. ' "$background_count"
        else
            printf ' against the union of genes in the GMT file. '
        fi
    else
        printf 'ORA was skipped because no non-empty gene list was provided. '
    fi
    if [ "$ranked_gene_count" -gt 0 ]; then
        printf 'Preranked GSEA used %s ranked genes. ' "$ranked_gene_count"
    else
        printf 'Preranked GSEA was skipped because no ranked gene table was provided. '
    fi
    printf 'Gene sets were read from a user-supplied GMT file; gene identifiers were treated as exact strings with no ID conversion, organism inference, online lookup, or gene-set download. '
    printf 'The primary dotplot was re-rendered by the flow with wrapped term labels for readability. '
    printf 'The dotplot.original.pdf/png files are an optimized classic/original-style re-rendering with wider labels; the raw dependency plot remains in 02_intermediate/enrichment-r/dotplot.pdf/png for audit. '
    printf 'The flow also rendered an ORA adjusted-p-value barplot, a GSEA normalized-enrichment-score plot, GSEA running enrichment score curves, and plot_summary.tsv. '
    printf 'Parameters were min_size=%s, max_size=%s, pvalue_cutoff=%s, padj_method=%s, top_n=%s, seed=%s.\n' "$min_size" "$max_size" "$pvalue_cutoff" "$padj_method" "$top_n" "$seed"
} > "$methods_file"

finished_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
{
    printf '{\n'
    printf '  "flow": "rnaseq-enrichment-flow",\n'
    printf '  "version": %s,\n' "$(json_string "$FLOW_VERSION")"
    printf '  "started_at": %s,\n' "$(json_string "$started_at")"
    printf '  "finished_at": %s,\n' "$(json_string "$finished_at")"
    printf '  "inputs": {\n'
    printf '    "gene_list": %s,\n' "$(json_string "$gene_list_path")"
    printf '    "ranked_genes": %s,\n' "$(json_string "$ranked_genes_path")"
    printf '    "gene_sets": %s,\n' "$(json_string "$gene_sets_path")"
    printf '    "background": %s\n' "$(json_string "$background_path")"
    printf '  },\n'
    printf '  "parameters": {\n'
    printf '    "id_column": %s,\n' "$(json_string "$id_column")"
    printf '    "score_column": %s,\n' "$(json_string "$score_column")"
    printf '    "min_size": %s,\n' "$min_size"
    printf '    "max_size": %s,\n' "$max_size"
    printf '    "pvalue_cutoff": %s,\n' "$pvalue_cutoff"
    printf '    "padj_method": %s,\n' "$(json_string "$padj_method")"
    printf '    "top_n": %s,\n' "$top_n"
    printf '    "seed": %s\n' "$seed"
    printf '  },\n'
    printf '  "dependencies": {\n'
    printf '    "taf-enrichment-r": "0.1.0-r1"\n'
    printf '  },\n'
    printf '  "counts": {\n'
    printf '    "gene_sets": %s,\n' "$gene_set_count"
    printf '    "gene_list_genes": %s,\n' "$gene_list_count"
    printf '    "ranked_genes": %s,\n' "$ranked_gene_count"
    printf '    "background_genes": %s,\n' "$background_count"
    printf '    "ora_result_count": %s,\n' "$ora_result_count"
    printf '    "gsea_result_count": %s,\n' "$gsea_result_count"
    printf '    "plot_terms": %s,\n' "$plot_terms"
    printf '    "classic_plot_terms": %s,\n' "$classic_plot_terms"
    printf '    "ora_barplot_terms": %s,\n' "$ora_barplot_terms"
    printf '    "gsea_nes_terms": %s,\n' "$gsea_nes_terms"
    printf '    "gsea_curve_terms": %s\n' "$gsea_curve_terms"
    printf '  },\n'
    printf '  "outputs": {\n'
    printf '    "ora_results": %s,\n' "$(json_string "$enrichment_dir/ora_results.tsv")"
    printf '    "gsea_results": %s,\n' "$(json_string "$enrichment_dir/gsea_results.tsv")"
    printf '    "enrichment_summary": %s,\n' "$(json_string "$enrichment_dir/enrichment_summary.tsv")"
    printf '    "dotplot_pdf": %s,\n' "$(json_string "$enrichment_dir/dotplot.pdf")"
    printf '    "dotplot_png": %s,\n' "$(json_string "$enrichment_dir/dotplot.png")"
    printf '    "dotplot_original_pdf": %s,\n' "$(json_string "$enrichment_dir/dotplot.original.pdf")"
    printf '    "dotplot_original_png": %s,\n' "$(json_string "$enrichment_dir/dotplot.original.png")"
    printf '    "ora_barplot_pdf": %s,\n' "$(json_string "$enrichment_dir/ora_barplot.pdf")"
    printf '    "ora_barplot_png": %s,\n' "$(json_string "$enrichment_dir/ora_barplot.png")"
    printf '    "gsea_nes_plot_pdf": %s,\n' "$(json_string "$enrichment_dir/gsea_nes_plot.pdf")"
    printf '    "gsea_nes_plot_png": %s,\n' "$(json_string "$enrichment_dir/gsea_nes_plot.png")"
    printf '    "gsea_enrichment_curves_pdf": %s,\n' "$(json_string "$enrichment_dir/gsea_enrichment_curves.pdf")"
    printf '    "gsea_enrichment_curves_png": %s,\n' "$(json_string "$enrichment_dir/gsea_enrichment_curves.png")"
    printf '    "dotplot_source": %s,\n' "$(json_string "$plot_metadata_file")"
    printf '    "plot_summary": %s,\n' "$(json_string "$plot_summary_file")"
    printf '    "flow_summary": %s\n' "$(json_string "$flow_summary_file")"
    printf '  }\n'
    printf '}\n'
} > "$manifest_file"

log "completed. Results: $enrichment_dir"
log "reports: $reports_dir"
